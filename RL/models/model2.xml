<mujoco model="model0">
  <option gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.9 0.95 1.0" rgb2="0.25 0.45 0.75"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="300 300" reflectance="0.05"/>
  </asset>


  <worldbody>       <!--friction = sliding, torsional, rolling-->
    <geom name="floor" type="plane" size="50 50 0.1" material="grid" friction="0.1 0.005 0.0001"/>

    <light pos="0 0 3" dir="0 0 -1"/>

    <body name="robot" pos="0 0 0.0610"> <!-- where robot origin starts (0.0605 is wheels touching ground perfectly)-->
      <!-- if no freejoint, then it stays frozen where spawned-->   <!-- forward x axis-->
      <freejoint/>
      
      <!-- base -->
      <body name="base" pos="0 0 0">
        <geom type="box" size="0.046 0.083 0.009" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.160"/> 
      </body>

      <!-- brackets -->
      <body name="left_bracket" pos="0 0 0">
        <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 0.068 -0.0105" mass="0.005"/> <!-- bracket left top bit -->
        <geom type="box" size="0.013 0.0015 0.0165" rgba="0.5 0.5 0.5 1" pos="0 0.0845 -0.0255" mass="0.006"/> <!-- bracket left motor bit -->
      </body>

      <body name="right_bracket" pos="0 0 0">
        <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 -0.068 -0.0105" mass="0.005"/> <!-- bracket right top bit -->
        <geom type="box" size="0.013 0.0015 0.0165" rgba="0.5 0.5 0.5 1" pos="0 -0.0845 -0.0255" mass="0.006"/> <!-- bracket right motor bit -->
      </body>

      <!-- motors -->  <!-- (radius, half len)-->
      <body name="left_motor" pos="0 0 0">
        <geom type="cylinder" size="0.0125 0.0250" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0.058 -0.0255" mass="0.087"/> <!-- motor body left-->
        <geom type="cylinder" size="0.0015 0.0025" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0.0875 -0.0255" mass="0.010"/> <!-- motor rod left-->
      </body>

      <body name="right_motor" pos="0 0 0">
        <geom type="cylinder" size="0.0125 0.0250" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 -0.058 -0.0255" mass="0.087"/> <!-- motor body right-->
        <geom type="cylinder" size="0.0015 0.0025" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 -0.0875 -0.0255" mass="0.010"/> <!-- motor rod right-->
      </body>

      <!-- neck -->
      <body name="neck" pos="0 0 0">
        <geom type="box" size="0.009 0.01625 0.290" rgba="0.5 0.5 0.5 1" pos="0 0 0.290" mass="0.214"/> 
      </body>

      <!-- battery block-->
      <!-- none for now
      <body name="battery_block" pos="0 0 0.0610">
        <geom type="box" size="0.0 0.0 0.0" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.200"/> 
      </body>
      -->

      <!-- electronics block -->
      <body name="electronics_block" pos="0 0 0">
        <geom type="box" size="0.04 0.03 0.01" rgba="0.5 0.5 0.5 1" pos="0 0.050 0.014" mass="0.120"/> 
      </body>

      <!-- WHEELS not rigid-->
      <body name="wheel_left" pos="0 0.105 -0.0255">
        <joint name="wheel_left_joint" type="hinge" axis="0 1 0" frictionloss="0.2" damping="0.0" armature="6.8e-4"/> <!-- rotate about y -->
        <geom type="cylinder" size="0.035 0.015" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" pos="0 0 0" mass="0.049" friction="1.0 0.005 0.0001"/> <!-- wheel left-->
        <site name="spin_left"  pos="0.028 0.016 0" size="0.002" rgba="1 0 0 1"/> <!-- red marker to see left wheel spin direction-->
      </body>

      <!-- frictionloss (coulomb friction - const opposing torque -> DEADBAND)-->
      <body name="wheel_right" pos="0 -0.105 -0.0255">  
        <joint name="wheel_right_joint" type="hinge" axis="0 1 0" frictionloss="0.2" damping="0.0" armature="6.8e-4"/> <!-- rotate about y -->
        <geom type="cylinder" size="0.035 0.015" zaxis="0 1 0" rgba="0.2 0.2 0.2 1" pos="0 0 0" mass="0.049" friction="1.0 0.005 0.0001"/> <!-- wheel left  (friction="slide torsion roll")-->
        <site name="spin_right"  pos="0.028 -0.016 0" size="0.002" rgba="0 1 0 1"/> <!-- green marker to see right wheel spin direction-->
      </body>

      <!-- site for imu sensor to attach to -->
      <site name="imu" pos="0.02 0.03 0.025" size="0.005" rgba="1 0 0.5 1"/>

    </body>

  </worldbody>


  <!-- stop contact between motor rod and wheels -->
  <contact>
    <exclude body1="left_motor" body2="wheel_left"/>
    <exclude body1="right_motor" body2="wheel_right"/>
  </contact>

  <!-- need going over - more accurate actuator model -->
  <actuator>
    <general name="wheel_left_motor" joint="wheel_left_joint" gear="1" ctrlrange="-1 1" gaintype="fixed" gainprm="0.43 0 0" biastype="affine" biasprm="0 0 -0.017"/>
    <general name="wheel_right_motor" joint="wheel_right_joint" gear="1" ctrlrange="-1 1" gaintype="fixed" gainprm="0.43 0 0" biastype="affine" biasprm="0 0 -0.017"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <jointvel name="wheel_left_vel" joint="wheel_left_joint"/>
    <jointvel name="wheel_right_vel" joint="wheel_right_joint"/>
  </sensor>

</mujoco>