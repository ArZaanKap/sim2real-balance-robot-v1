<mujoco model="model0">
  <option gravity="0 0 -9.81"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.9 0.95 1.0" rgb2="0.25 0.45 0.75"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>


  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <light pos="0 0 3" dir="0 0 -1"/>

    <body name="robot" pos="0 0 1">
      <!-- if no freejoint, then it stays frozen where spawned-->   <!-- forward x axis-->
      <freejoint/>
      <geom type="box" size="0.046 0.083 0.009" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="160"/> <!-- base -->
      <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 0.068 -0.0105" mass="5"/> <!-- bracket right top bit -->
      <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 -0.068 -0.0105" mass="5"/> <!-- bracket left top bit -->
      <geom type="box" size="0.013 0.0015 0.015" rgba="0.5 0.5 0.5 1" pos="0 0.0 0" mass="6"/> <!-- bracket right motor bit -->
      
    </body>

    
  </worldbody>


<mujoco/>