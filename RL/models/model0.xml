<mujoco model="model0">
  <option gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.9 0.95 1.0" rgb2="0.25 0.45 0.75"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.05"/>
  </asset>


  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <light pos="0 0 3" dir="0 0 -1"/>

    <body name="robot" pos="0 0 0.0610"> <!-- where robot origin starts (0.0605 is wheels touching ground perfectly)-->
      <!-- if no freejoint, then it stays frozen where spawned-->   <!-- forward x axis-->
      <freejoint/>
      <!-- base -->
      <geom type="box" size="0.046 0.083 0.009" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.160"/> 

      <!-- brackets -->
      <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 0.068 -0.0105" mass="0.005"/> <!-- bracket left top bit -->
      <geom type="box" size="0.013 0.015 0.0015" rgba="0.5 0.5 0.5 1" pos="0 -0.068 -0.0105" mass="0.005"/> <!-- bracket right top bit -->
      <geom type="box" size="0.013 0.0015 0.0165" rgba="0.5 0.5 0.5 1" pos="0 0.0845 -0.0255" mass="0.006"/> <!-- bracket left motor bit -->
      <geom type="box" size="0.013 0.0015 0.0165" rgba="0.5 0.5 0.5 1" pos="0 -0.0845 -0.0255" mass="0.006"/> <!-- bracket right motor bit -->

      <!-- motor -->  <!-- (radius, half len)-->
      <geom type="cylinder" size="0.0125 0.0250" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0.058 -0.0255" mass="0.087"/> <!-- motor body left-->
      <geom type="cylinder" size="0.0125 0.0250" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 -0.058 -0.0255" mass="0.087"/> <!-- motor body right-->
      <geom type="cylinder" size="0.0015 0.0025" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0.0875 -0.0255" mass="0.010"/> <!-- motor rod left-->
      <geom type="cylinder" size="0.0015 0.0025" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 -0.0875 -0.0255" mass="0.010"/> <!-- motor rod right-->

      <!-- neck -->
      <geom type="box" size="0.009 0.01625 0.290" rgba="0.5 0.5 0.5 1" pos="0 0 0.290" mass="0.214"/> 

      <!-- battery block-->
      <!-- none for now
      <geom type="box" size="0.0 0.0 0.0" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.200"/> 
      -->

      <!-- electronics block -->
      <geom type="box" size="0.04 0.03 0.01" rgba="0.5 0.5 0.5 1" pos="0 0.050 0.005" mass="0.120"/> 


      <!-- wheels not rigid-->
      <body name="wheel_left" pos="0 0.1045 -0.0255">
        <joint name="wheel_left_joint" type="hinge" axis="0 1 0" frictionloss="0.2" damping="0.005" armature="6.8e-4"/> <!-- rotate about y -->
        <geom type="cylinder" size="0.035 0.015" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.049" friction="1.0 0.005 0.0001"/> <!-- wheel left-->
      </body>

      <!-- frictionloss (coulomb friction - const opposing torque -> DEADBAND)-->
      <body name="wheel_right" pos="0 -0.1045 -0.0255">  
        <joint name="wheel_right_joint" type="hinge" axis="0 1 0" frictionloss="0.2" damping="0.005" armature="6.8e-4"/> <!-- rotate about y -->
        <geom type="cylinder" size="0.035 0.015" zaxis="0 1 0" rgba="0.5 0.5 0.5 1" pos="0 0 0" mass="0.049" friction="1.0 0.005 0.0001"/> <!-- wheel left  (friction="slide torsion roll")-->
      </body>

      <!-- site for imu sensor to attach to -->
      <site name="imu" pos="0.02 0.03 0.019" size="0.005" rgba="1 0 0.5 1"/>

    </body>
  </worldbody>

  <actuator>
    <motor name="wheel_left_motor" joint="wheel_left_joint" gear="1" ctrlrange="-0.43 0.43" />
    <motor name="wheel_right_motor" joint="wheel_right_joint" gear="1" ctrlrange="-0.43 0.43"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <jointvel name="wheel_left_vel" joint="wheel_left_joint"/>
    <jointvel name="wheel_right_vel" joint="wheel_right_joint"/>
  </sensor>

</mujoco>